{% extends 'base_admin.twig' %}

{% block content %}
<div class="reports-container">
    <div class="admin-card">
        <h3>Booking Reports</h3>
        <p class="text-muted">Export detailed list of all bookings including customer info, tables, and prices.</p>
        
        <form action="/admin/reports/view" method="GET" target="_self">
            <input type="hidden" name="type" value="bookings">
            
            <div class="form-row">
                <div class="form-group">
                    <label>From</label>
                    <input type="date" name="start" value="{{ 'now'|date('Y-m-01') }}" required>
                </div>
                <div class="form-group">
                    <label>To</label>
                    <input type="date" name="end" value="{{ 'now'|date('Y-m-d') }}" required>
                </div>
            </div>

            <div class="form-group" style="margin-bottom: 20px;">
                <label>Granularity</label>
                <select name="granularity" class="form-control" style="width: 100%; padding: 8px; border-radius: 4px; border: 1px solid #444; background: #222; color: #fff;">
                    <option value="total">Total List (All in one block)</option>
                    <option value="day">By Day</option>
                    <option value="week">By Week</option>
                    <option value="month">By Month</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary btn-block">
                <i class="fas fa-eye"></i> Generate Preview
            </button>
        </form>
    </div>

    <div class="admin-card">
        <h3>Financial Reports</h3>
        <p class="text-muted">Revenue breakdown by service (Game), detailed by completed bookings only.</p>
        
        <form action="/admin/reports/view" method="GET" target="_self">
            <input type="hidden" name="type" value="finance">
            
            <div class="form-row">
                <div class="form-group">
                    <label>From</label>
                    <input type="date" name="start" value="{{ 'now'|date('Y-m-01') }}" required>
                </div>
                <div class="form-group">
                    <label>To</label>
                    <input type="date" name="end" value="{{ 'now'|date('Y-m-d') }}" required>
                </div>
            </div>

            <div class="form-group" style="margin-bottom: 20px;">
                <label>Granularity</label>
                <select name="granularity" class="form-control" style="width: 100%; padding: 8px; border-radius: 4px; border: 1px solid #444; background: #222; color: #fff;">
                    <option value="total">Total Summary</option>
                    <option value="day">By Day</option>
                    <option value="week">By Week</option>
                    <option value="month">By Month</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary btn-block">
                 <i class="fas fa-eye"></i> Generate Preview
            </button>
        </form>
    </div>

    <div class="admin-card">
        <h3>Promo Code Reports</h3>
        <p class="text-muted">Usage statistics for coupons used within the selected period.</p>
        
        <form action="/admin/reports/view" method="GET" target="_self">
             <input type="hidden" name="type" value="promo">
             
            <div class="form-row">
                <div class="form-group">
                    <label>From</label>
                    <input type="date" name="start" value="{{ 'now'|date('Y-m-01') }}" required>
                </div>
                <div class="form-group">
                    <label>To</label>
                    <input type="date" name="end" value="{{ 'now'|date('Y-m-d') }}" required>
                </div>
            </div>
             
            <div class="form-group" style="margin-bottom: 20px;">
                <label>Granularity</label>
                <select name="granularity" class="form-control" style="width: 100%; padding: 8px; border-radius: 4px; border: 1px solid #444; background: #222; color: #fff;">
                    <option value="total">Total Summary</option>
                    <option value="day">By Day</option>
                    <option value="week">By Week</option>
                    <option value="month">By Month</option>
                </select>
            </div>

             <button type="submit" class="btn btn-primary btn-block">
                 <i class="fas fa-eye"></i> Generate Preview
            </button>
        </form>
    </div>

    <div class="admin-card">
        <h3>Tables Occupancy</h3>
        <p class="text-muted">Analysis of table usage duration and booking counts.</p>
        
        <form action="/admin/reports/view" method="GET" target="_self">
             <input type="hidden" name="type" value="tables">
             
            <div class="form-row">
                <div class="form-group">
                    <label>From</label>
                    <input type="date" name="start" value="{{ 'now'|date('Y-m-01') }}" required>
                </div>
                <div class="form-group">
                    <label>To</label>
                    <input type="date" name="end" value="{{ 'now'|date('Y-m-d') }}" required>
                </div>
            </div>
             
            <div class="form-group" style="margin-bottom: 20px;">
                <label>Granularity</label>
                <select name="granularity" class="form-control" style="width: 100%; padding: 8px; border-radius: 4px; border: 1px solid #444; background: #222; color: #fff;">
                    <option value="total">Total Summary</option>
                    <option value="day">By Day</option>
                    <option value="week">By Week</option>
                    <option value="month">By Month</option>
                </select>
            </div>

             <button type="submit" class="btn btn-primary btn-block">
                 <i class="fas fa-eye"></i> Generate Preview
            </button>
        </form>
    </div>
</div>

<style>
    .reports-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
        margin-top: 20px;
        align-items: stretch;
    }
    
    /* Removed strict media queries for columns as auto-fit handles it better */
    
    /* Make cards flex columns to align footer/button at bottom if needed */
    .admin-card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 30px 25px;
        height: 100%;
        min-height: 380px; /* Slightly reduced min-height */
    }
    
    .admin-card h3 {
        margin-bottom: 15px;
    }
    
    .admin-card p.text-muted {
        flex-grow: 1; 
        margin-bottom: 25px;
    }
    
    .form-row {
        display: flex;
        gap: 10px; /* Reduced gap slightly to help fitting */
        margin-bottom: 20px;
        flex-wrap: wrap; /* Allow wrapping if card gets too squeezed */
    }
    
    .form-group {
        flex: 1 1 120px; /* Flex-basis 120px allows wrapping if super small */
        min-width: 0;
    }
    
    /* Input sizing fix */
    .form-group input,
    .form-group select {
        width: 100%;
        box-sizing: border-box; /* Ensure padding doesn't break layout */
    }

    .form-group label {
        font-size: 0.85em;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
        display: block;
    }
    
    .btn-block {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        margin-top: auto; /* Push to bottom of flex card */
    }
    
    .text-muted {
        color: rgba(255,255,255,0.6);
        font-size: 0.9em;
        line-height: 1.4;
    }
</style>
{% endblock %}
