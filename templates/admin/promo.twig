{% extends 'base_admin.twig' %}

{% block content %}
<div class="admin-card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid var(--admin-border); padding-bottom: 10px;">
        <h3 style="color: var(--color-gold);">Manage Promocodes</h3>
        <div style="display: flex; gap: 10px;">
            <button onclick="showTab('list')" class="btn btn-sm btn-primary tab-toggle active">Active Codes</button>
            <button onclick="showTab('create')" class="btn btn-sm btn-primary tab-toggle">Create New</button>
            <button onclick="showTab('generate')" class="btn btn-sm btn-secondary tab-toggle">Mass Generator</button>
        </div>
    </div>

    <!-- Active List -->
    <div id="tab-list" class="tab-pane" style="display: block;">
        <div style="max-height: 70vh; overflow-y: auto;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Discount</th>
                        <th>Type</th>
                        <th>Actual Usage</th>
                        <th>Usage Limit</th>
                        <th>Valid Until</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for coupon in coupons %}
                    <tr>
                        <td>
                            <strong style="color: var(--color-gold); font-family: monospace; font-size: 1.1em;">{{ coupon.code }}</strong>
                        </td>
                        <td>
                            {% if coupon.discount_amount %}
                                {{ coupon.discount_amount }} €
                            {% else %}
                                {{ coupon.discount_percent }}%
                            {% endif %}
                        </td>
                        <td>
                            {% if coupon.type == 'standard' %}Standard
                            {% elseif coupon.type == 'multi_use' %}Multi-Use
                            {% elseif coupon.type == 'promo' %}Promo
                            {% else %}{{ coupon.type|capitalize }}{% endif %}
                        </td>
                        <td>
                             <span style="font-weight: bold; color: #fff;">{{ coupon.current_uses|default(0) }}</span>
                        </td>
                        <td>
                            {% if coupon.usage_limit is null %}
                                <span class="badge badge-success">Unlimited</span>
                            {% else %}
                                {{ coupon.usage_limit }} uses
                            {% endif %}
                        </td>
                        <td>
                            {% if coupon.valid_until and coupon.valid_until != '0000-00-00' %}
                                {{ coupon.valid_until|date('d.m.Y') }}
                            {% else %}
                                <span style="opacity: 0.5;">No expiry</span>
                            {% endif %}
                        </td>
                        <td>{{ coupon.created_at|date('d.m.Y H:i') }}</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-primary" data-coupon="{{ coupon|json_encode|e('html_attr') }}" onclick="editCoupon(this)" style="margin-right: 5px;">Edit</button>
                            <form method="POST" action="/admin/promo/delete" onsubmit="return confirm('Delete this coupon?');" style="display: inline;">
                                <input type="hidden" name="id" value="{{ coupon.id }}">
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="8" style="text-align: center; padding: 20px;">No promocodes found.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Create Form -->
    <div id="tab-create" class="tab-pane" style="display: none;">
        <div style="background: rgba(255,255,255,0.02); padding: 20px; border-radius: 8px; max-width: 500px; margin: 0 auto;">
            <h4>Create Coupon</h4>
            <form method="POST" action="/admin/promo/create">
                <div class="form-group">
                    <label>Code</label>
                    <input type="text" name="code" placeholder="e.g. SUMMER2024" required style="width: 100%;">
                </div>
                
                <div class="row" style="display: flex; gap: 15px;">
                    <div class="col" style="flex: 1;">
                         <div class="form-group">
                            <label>Discount Value</label>
                            <input type="number" name="discount" step="0.01" min="0" placeholder="10" required style="width: 100%;">
                        </div>
                    </div>
                    <div class="col" style="flex: 1;">
                         <div class="form-group">
                            <label>Discount Type</label>
                            <select name="discount_type" style="width: 100%;">
                                <option value="percent">Percent (%)</option>
                                <option value="amount">Euro (€)</option>
                            </select>
                        </div>
                    </div>
                    <div class="col" style="flex: 1;">
                         <div class="form-group">
                            <label>Coupon Type</label>
                            <select name="type" style="width: 100%;">
                                <option value="standard">Standard</option>
                                <option value="multi_use">Multi-Use</option>
                                <option value="promo">Promo</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row" style="display: flex; gap: 15px;">
                    <div class="col" style="flex: 1;">
                         <div class="form-group">
                            <label>Usage Limit (Uses)</label>
                            <input type="number" name="usage_limit" min="0" placeholder="0 or Empty = Unlimited" style="width: 100%;">
                            <small class="form-text text-muted" style="font-size: 0.75em; opacity: 0.7;">Leave empty or 0 for unlimited.</small>
                        </div>
                    </div>
                     <div class="col" style="flex: 1;">
                         <div class="form-group">
                            <label>Valid Until</label>
                            <input type="date" name="valid_until" style="width: 100%;">
                            <small class="form-text text-muted" style="font-size: 0.75em; opacity: 0.7;">Leave empty for no expiry.</small>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 10px;">Create / Update Coupon</button>
            </form>
        </div>
    </div>

    <!-- Generate Form -->
    <div id="tab-generate" class="tab-pane" style="display: none;">
        <div style="background: rgba(255,255,255,0.02); padding: 20px; border-radius: 8px; max-width: 500px; margin: 0 auto;">
            <h4>Mass Generate</h4>
            <form method="POST" action="/admin/promo/generate">
                <div class="form-group">
                    <label>Quantity</label>
                    <input type="number" name="amount" placeholder="50" required style="width: 100%;">
                </div>
                <div class="form-group">
                    <label>Prefix</label>
                    <input type="text" name="prefix" placeholder="e.g. VIP" style="width: 100%;">
                </div>
                 <div class="row" style="display: flex; gap: 15px;">
                    <div class="col" style="flex: 1;">
                        <div class="form-group">
                            <label>Discount Value</label>
                            <input type="number" name="discount" step="0.01" min="0" placeholder="10" required style="width: 100%;">
                        </div>
                    </div>
                    <div class="col" style="flex: 1;">
                         <div class="form-group">
                            <label>Discount Type</label>
                            <select name="discount_type" style="width: 100%;">
                                <option value="percent">Percent (%)</option>
                                <option value="amount">Euro (€)</option>
                            </select>
                        </div>
                    </div>
                </div>
                
                 <div class="row" style="display: flex; gap: 15px;">
                    <div class="col" style="flex: 1;">
                        <div class="form-group">
                            <label>Usage Limit (per coupon)</label>
                            <input type="number" name="usage_limit" min="0" placeholder="0 = Unlimited" style="width: 100%;">
                            <small>Default: Unlimited</small>
                        </div>
                    </div>
                    <div class="col" style="flex: 1;">
                         <div class="form-group">
                            <label>Valid Until</label>
                            <input type="date" name="valid_until" style="width: 100%;">
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-secondary" style="width: 100%; margin-top: 10px;">Generate Coupons</button>
            </form>
        </div>
    </div>
</div>

<script>
function showTab(tabName) {
    // Hide all tabs
    document.querySelectorAll('.tab-pane').forEach(el => el.style.display = 'none');
    document.getElementById('tab-' + tabName).style.display = 'block';
    
    // Update toggle buttons
    document.querySelectorAll('.tab-toggle').forEach(el => el.style.opacity = '0.7');
    document.querySelectorAll('.tab-toggle').forEach(el => el.classList.remove('active'));
    
    // Highlight active (find button that targets this tab)
    const activeBtn = document.querySelector(`button[onclick="showTab('${tabName}')"]`);
    if(activeBtn) {
        activeBtn.style.opacity = '1';
        activeBtn.classList.add('active');
    }
}

function editCoupon(btn) {
    const data = JSON.parse(btn.getAttribute('data-coupon'));
    // Populate form fields
    const form = document.querySelector('#tab-create form');
    form.querySelector('input[name="code"]').value = data.code;
    
    if (data.discount_amount && parseFloat(data.discount_amount) > 0) {
        form.querySelector('input[name="discount"]').value = data.discount_amount;
        form.querySelector('select[name="discount_type"]').value = 'amount';
    } else {
        form.querySelector('input[name="discount"]').value = data.discount_percent;
        form.querySelector('select[name="discount_type"]').value = 'percent';
    }
    
    form.querySelector('select[name="type"]').value = data.type;
    
    // Usage limit: null means unlimited (empty input)
    form.querySelector('input[name="usage_limit"]').value = (data.usage_limit === null) ? '' : data.usage_limit;
    
    // Date: '0000-00-00' or null means empty
    if (data.valid_until && data.valid_until !== '0000-00-00') {
        form.querySelector('input[name="valid_until"]').value = data.valid_until;
    } else {
        form.querySelector('input[name="valid_until"]').value = '';
    }

    // Switch to create tab
    showTab('create');
    
    // Update heading to indicate editing (optional UX polish)
    document.querySelector('#tab-create h4').innerText = 'Edit Coupon: ' + data.code;
    
    // Scroll to top
    window.scrollTo(0, 0);
}
</script>

<style>
.tab-toggle.active {
    background: var(--color-gold) !important;
    color: #000 !important;
    opacity: 1 !important;
}
</style>
{% endblock %}
