{% extends 'base_admin.twig' %}

{% block content %}
<div class="admin-card">
    <div style="margin-bottom: 20px; border-bottom: 1px solid var(--admin-border); padding-bottom: 20px;">
        <!-- Level 1 Tabs: Services/Status -->
        <div class="tabs-container">
            <ul class="admin-tabs-l1" role="tablist">
                {% for slug, tab in tabs %}
                    <li class="nav-item">
                        <button class="nav-link-l1 {% if loop.first %}active{% endif %}" 
                                data-target="{{ slug }}"
                                type="button">
                            {{ tab.label }}
                        </button>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>

    <div class="tab-content-container">
        {% for slug, tab in tabs %}
            <div class="tab-pane-l1 {% if loop.first %}active{% endif %}" id="{{ slug }}">
                
                <!-- Level 2 Tabs: Date Groups (Only if bookings is array of groups) -->
                {% set isGrouped = tab.bookings.today is defined %}
                
                {% if isGrouped %}
                    <!-- Date Tabs -->
                    <div class="sub-tabs-wrapper">
                        <ul class="admin-tabs-l2" role="tablist">
                            {% for groupName in ['yesterday', 'today', 'tomorrow', 'later'] %}
                                <li class="nav-item">
                                    <button class="nav-link-l2 {% if groupName == 'today' %}active{% endif %}" 
                                            data-target="{{ slug }}-{{ groupName }}"
                                            type="button">
                                        {{ groupName|capitalize }}
                                    </button>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>

                    <!-- Date Panes -->
                    {% for groupName, bookings in tab.bookings %}
                        <div class="tab-pane-l2 {% if groupName == 'today' %}active{% endif %}" id="{{ slug }}-{{ groupName }}">
                            {% include 'admin/_bookings_table.twig' with {'bookings': bookings, 'group': groupName} %}
                        </div>
                    {% endfor %}

                {% else %}
                    <!-- Fallback for flat array (if any logic remains flat) -->
                    {% include 'admin/_bookings_table.twig' with {'bookings': tab.bookings} %}
                {% endif %}
                
            </div>
        {% endfor %}
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Generic Tab Switcher that works for L1 and L2
        function setupTabs(linkSelector, paneSelector) {
            const links = document.querySelectorAll(linkSelector);
            const panes = document.querySelectorAll(paneSelector);

            links.forEach(link => {
                link.addEventListener('click', (e) => {
                    e.preventDefault();
                    const targetId = link.dataset.target;
                    
                    // Deactivate siblings
                    const parentList = link.closest('ul');
                    parentList.querySelectorAll(linkSelector).forEach(l => l.classList.remove('active'));
                    
                    // Activate clicked
                    link.classList.add('active');

                    // Find the container of panes that corresponds to this level
                    // For L1: globally unique IDs.
                    // For L2: globally unique IDs (slug-group).
                    // We just need to hide all *sibling* panes.
                    // But "sibling panes" are not always direct DOM siblings.
                    
                    // Simple approach: Toggle ID visibility.
                    // But we must deselect the *current active pane* in the same scope.
                    // How to find scope?
                    
                    // Let's use specific logic for L1 and L2 to be safe.
                });
            });
        }

        // Level 1 Switcher
        document.querySelectorAll('.nav-link-l1').forEach(btn => {
            btn.addEventListener('click', () => {
                // 1. Toggle Button Class
                document.querySelectorAll('.nav-link-l1').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');

                // 2. Toggle Pane Visibility via ID
                const targetId = btn.dataset.target;
                document.querySelectorAll('.tab-pane-l1').forEach(p => p.classList.remove('active'));
                const targetPane = document.getElementById(targetId);
                targetPane?.classList.add('active');

                // 3. Force "Today" Sub-tab Activation
                // This resets the view to "Today" whenever a game tab is clicked
                if (targetPane) {
                    const todayBtn = targetPane.querySelector(`.nav-link-l2[data-target="${targetId}-today"]`);
                    const todayPane = document.getElementById(`${targetId}-today`);
                    
                    if (todayBtn && todayPane) {
                        // Deactivate siblings in this pane
                        targetPane.querySelectorAll('.nav-link-l2').forEach(b => b.classList.remove('active'));
                        targetPane.querySelectorAll('.tab-pane-l2').forEach(p => p.classList.remove('active'));
                        
                        // Activate Today
                        todayBtn.classList.add('active');
                        todayPane.classList.add('active');
                    }
                }

                // 4. Save State only for L1
                localStorage.setItem('activeAdminTabL1', targetId);
            });
        });

        // Level 2 Switcher (Scoped per Service Tab)
        document.querySelectorAll('.nav-link-l2').forEach(btn => {
            btn.addEventListener('click', () => {
                const targetId = btn.dataset.target; // e.g., pool-today
                const wrapper = btn.closest('.tab-pane-l1'); // Find parent L1 Pane
                
                // 1. Toggle Buttons *within this L1 Pane*
                wrapper.querySelectorAll('.nav-link-l2').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');

                // 2. Toggle Panes *within this L1 Pane*
                wrapper.querySelectorAll('.tab-pane-l2').forEach(p => p.classList.remove('active'));
                document.getElementById(targetId)?.classList.add('active');
            });
        });

        // Restore L1 State
        const storedL1 = localStorage.getItem('activeAdminTabL1');
        if (storedL1) {
            const btn = document.querySelector(`.nav-link-l1[data-target="${storedL1}"]`);
            if (btn) btn.click();
        }
    });
</script>

<style>
    /* L1 Tabs (Services) */
    .admin-tabs-l1 {
        list-style: none; margin: 0; padding: 0; display: flex; gap: 10px; flex-wrap: wrap;
    }
    .nav-link-l1 {
        display: block; padding: 12px 28px;
        background: rgba(26, 20, 16, 0.6);
        border: 1px solid rgba(212, 175, 55, 0.3);
        color: var(--color-text); font-weight: 600; font-size: 1.1rem;
        border-radius: 4px; cursor: pointer; text-transform: capitalize;
    }
    .nav-link-l1:hover, .nav-link-l1.active {
        background: var(--color-gold); color: var(--color-espresso); border-color: var(--color-gold);
    }
    
    .tab-pane-l1 { display: none; }
    .tab-pane-l1.active { display: block; animation: fadeIn 0.3s; }

    /* L2 Tabs (Dates) */
    .sub-tabs-wrapper {
        margin: 20px 0 15px 0;
        padding-bottom: 10px;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    .admin-tabs-l2 {
        list-style: none; margin: 0; padding: 0; display: flex; gap: 5px;
    }
    .nav-link-l2 {
        padding: 6px 16px; font-size: 0.9rem;
        background: transparent; border: 1px solid rgba(255,255,255,0.2);
        color: rgba(255,255,255,0.7); border-radius: 20px;
        cursor: pointer; transition: all 0.2s;
    }
    .nav-link-l2:hover {
        background: rgba(255,255,255,0.1); color: #fff;
    }
    .nav-link-l2.active {
        background: rgba(255,255,255,0.9); color: #000; font-weight: 700; border-color: #fff;
    }

    .tab-pane-l2 { display: none; }
    .tab-pane-l2.active { display: block; animation: fadeIn 0.2s; }

    @keyframes fadeIn { from { opacity: 0; margin-top: 5px; } to { opacity: 1; margin-top: 0; } }
</style>

<!-- Extras / POS Modal -->
<div id="extrasModal" class="modal-overlay" style="display: none;">
    <div class="modal-content pos-modal">
        <span class="close-modal">&times;</span>
        <h2>Manage Extras & Time <small id="posBookingId" style="font-size: 0.6em; color: gray;"></small></h2>
        
        <div class="pos-tabs">
            <button class="pos-tab-btn active" data-tab="pos-extend">🕒 Extend Time</button>
            <button class="pos-tab-btn" data-tab="pos-cafe">☕ Cafe Menu</button>
            <button class="pos-tab-btn" data-tab="pos-list">🧾 Current Extras</button>
        </div>

        <div class="pos-body">
            <!-- Tab: Extend Time -->
            <div id="pos-extend" class="pos-tab-pane active">
                <div class="pos-section">
                    <h3>Extend Booking Duration</h3>
                    <p class="text-muted">Checks availability before extending.</p>
                    <div class="extend-controls">
                        <button type="button" class="qty-btn" onclick="adjustExtend(-1)">-</button>
                        <input type="number" id="extendHours" value="1" min="-3" max="5" readonly>
                        <button type="button" class="qty-btn" onclick="adjustExtend(1)">+</button>
                        <span style="font-size: 1.2em; font-weight: bold; margin-left: 10px;">Hours</span>
                    </div>
                    <div id="extendMsg" style="margin-top: 10px; min-height: 20px;"></div>
                    <button id="btnCheckAvailability" class="btn btn-primary btn-block" style="margin-top: 20px;" onclick="checkAvailability()">
                        Check Availability
                    </button>
                </div>
            </div>

            <!-- Tab: Cafe Menu -->
            <div id="pos-cafe" class="pos-tab-pane">
                <div id="cafeSuggestions" class="cafe-suggestions" style="display:none;"></div>
                <div id="cafeCategories" class="cafe-categories">
                    <!-- Categories loaded via JS -->
                    <div class="loading-spinner">Loading Menu...</div>
                </div>
            </div>

            <!-- Tab: Current Extras List -->
            <div id="pos-list" class="pos-tab-pane">
                <div id="currentExtrasList">
                    <!-- Loaded via JS -->
                </div>
                <div class="pos-footer-summary">
                     Total Price: <span id="posTotalPrice" style="font-weight: bold; font-size: 1.2em;">0.00 €</span>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let currentBookingId = 0;
    let currentBookingDuration = 1; // Default
    let cafeMenuData = null;
    let hasBookingChanged = false; // Track changes

    document.addEventListener('DOMContentLoaded', function() {
        // Tab Switching
        document.querySelectorAll('.pos-tab-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.pos-tab-btn').forEach(b => b.classList.remove('active'));
                document.querySelectorAll('.pos-tab-pane').forEach(p => p.classList.remove('active'));
                btn.classList.add('active');
                document.getElementById(btn.dataset.tab).classList.add('active');
            });
        });

        // POS Modal Logic
        const modal = document.getElementById('extrasModal');
        const closeBtn = modal.querySelector('.close-modal');

        // Open Modal
        document.addEventListener('click', function(e) {
            const btn = e.target.closest('.btn-extras');
            if (btn) {
                currentBookingId = btn.dataset.id;
                currentBookingDuration = parseFloat(btn.dataset.duration) || 1; 
                document.getElementById('posBookingId').textContent = '#' + currentBookingId + ' (' + currentBookingDuration + 'h)';
                hasBookingChanged = false; // Reset on open
                
                // Reset Extend UI
                const input = document.getElementById('extendHours');
                if(input) input.value = 1;
                const existingBtn = document.getElementById('btnAddTime');
                if(existingBtn) existingBtn.remove();
                const checkBtn = document.getElementById('btnCheckAvailability');
                if(checkBtn) checkBtn.style.display = 'block';
                document.getElementById('extendMsg').textContent = '';

                openPosModal();
            }
        });

        // Close Modal Helper
        function closePosModal() {
            modal.style.display = 'none';
            if (hasBookingChanged) {
                 location.reload(); // Refresh if changed
            }
        }

        // Close Modal Events
        closeBtn.addEventListener('click', closePosModal);
        window.addEventListener('click', (e) => {
            if (e.target === modal) closePosModal();
        });

        // ...
    });

    // ...

    function doExtendTime(hours) {
        const msg = document.getElementById('extendMsg');
        msg.textContent = 'Adding time...';
        
        callApi({
            action: 'extend_time',
            booking_id: currentBookingId,
            hours: hours
        }).then(data => {
            if(data.success) {
                msg.textContent = 'Успешно! Время продлено.'; // Success
                msg.className = 'text-success';
                document.getElementById('btnAddTime').remove(); // Remove button
                loadBookingExtras();
                hasBookingChanged = true; // Mark as changed
                // setTimeout(() => location.reload(), 1500); // Removed auto-reload, wait for close
            } else {
                msg.textContent = data.error || 'Ошибка';
                msg.className = 'text-danger';
            }
        });
    }

    function removeExtra(index) {
        if(!confirm('Remove this item?')) return;
        callApi({
            action: 'remove_item',
            booking_id: currentBookingId,
            index: index
        }).then(data => {
            if(data.success) {
                renderExtrasList(data.extras);
                document.getElementById('posTotalPrice').textContent = parseFloat(data.new_price).toFixed(2) + ' €';
                hasBookingChanged = true; // Mark as changed
            }
        });
    }

    function addCafeItem(id, name, price, btn) {
        const qtyInput = btn.parentElement.querySelector('.item-qty');
        const qty = parseInt(qtyInput.value);
        
        callApi({
            action: 'add_item',
            booking_id: currentBookingId,
            item: { id: id, name: name, price: price, qty: qty }
        }).then(() => {
            // Feedback?
            const originalText = btn.textContent;
            btn.textContent = '✔ Added';
            btn.classList.add('btn-success');
            setTimeout(() => {
                 btn.textContent = originalText;
                 btn.classList.remove('btn-success');
                 qtyInput.value = 1; // Reset
                 changeItemQty(btn.parentElement.querySelector('button:last-child'), 0); // Reset visibility
            }, 1000);
            loadBookingExtras(); // Refresh List
            hasBookingChanged = true; // Mark as changed
        });
    }

    function openPosModal() {
        const modal = document.getElementById('extrasModal');
        modal.style.display = 'flex'; // Flex for centering
        loadBookingExtras();
        
        // Removed Upsell Suggestions Logic as per User Request
        document.getElementById('cafeSuggestions').style.display = 'none';
        
        if (!cafeMenuData) {
            loadCafeMenu();
        } else {
            renderCafeMenu();
        }
        
        // Reset Extend Tab
        document.getElementById('extendHours').value = 1;
        document.getElementById('extendMsg').textContent = '';
        document.getElementById('extendMsg').className = '';
        const existingBtn = document.getElementById('btnAddTime');
        if(existingBtn) existingBtn.remove();
    }

    // Upsell functions removed/disabled
    
    function loadCafeMenu() {
        fetch('/admin/api/cafe-menu')
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    cafeMenuData = data.menu;
                    renderCafeMenu();
                }
            })
            .catch(err => console.error(err));
    }

    function renderCafeMenu() {
        const container = document.getElementById('cafeCategories');
        container.innerHTML = '';
        
        for (const [cat, items] of Object.entries(cafeMenuData)) {
            const section = document.createElement('div');
            section.className = 'cafe-cat-section collapsed'; // Default Collapsed
            
            const title = document.createElement('h4');
            title.textContent = cat.charAt(0).toUpperCase() + cat.slice(1).replace('_', ' ');
            title.addEventListener('click', () => {
                // Toggle this section
                const isCollapsed = section.classList.contains('collapsed');
                // Optional: Close others? "Accordion" usually implies one open. 
                // But user just said "hidden by default". Let's allow multiple open or one.
                // Let's do Standard Accordion (Close others).
                document.querySelectorAll('.cafe-cat-section').forEach(s => s.classList.add('collapsed'));
                
                if (isCollapsed) {
                    section.classList.remove('collapsed');
                }
            });
            section.appendChild(title);

            const grid = document.createElement('div');
            grid.className = 'cafe-grid';
            
            items.forEach(item => {
                const card = document.createElement('div');
                card.className = 'cafe-item-card';
                card.innerHTML = `
                    <div class="cafe-item-name">${item.name}</div>
                    <div class="cafe-item-price">${parseFloat(item.price).toFixed(2)} €</div>
                    <div class="cafe-item-actions">
                        <button class="qty-btn small" onclick="changeItemQty(this, -1)">-</button>
                        <input type="number" class="item-qty" value="1" min="1" readonly>
                        <button class="qty-btn small" onclick="changeItemQty(this, 1)">+</button>
                        <button class="btn-add-item" onclick="addCafeItem(${item.id}, '${item.name.replace(/'/g, "\\'")}', ${item.price}, this)">Add</button>
                    </div>
                `;
                grid.appendChild(card);
            });
            
            section.appendChild(grid);
            container.appendChild(section);
        }
    }

    function changeItemQty(btn, delta) {
        const input = btn.parentElement.querySelector('.item-qty');
        let val = parseInt(input.value) + delta;
        if (val < 1) val = 1;
        input.value = val;
        // Toggle Minus visibility if needed? User said "when 1 minus not displayed".
        const minusBtn = btn.parentElement.querySelector('button:first-child');
        minusBtn.style.visibility = (val === 1) ? 'hidden' : 'visible';
    }

    function addCafeItem(id, name, price, btn) {
        const qtyInput = btn.parentElement.querySelector('.item-qty');
        const qty = parseInt(qtyInput.value);
        
        callApi({
            action: 'add_item',
            booking_id: currentBookingId,
            item: { id: id, name: name, price: price, qty: qty }
        }).then(() => {
            // Feedback?
            const originalText = btn.textContent;
            btn.textContent = '✔ Added';
            btn.classList.add('btn-success');
            setTimeout(() => {
                 btn.textContent = originalText;
                 btn.classList.remove('btn-success');
                 qtyInput.value = 1; // Reset
                 changeItemQty(btn.parentElement.querySelector('button:last-child'), 0); // Reset visibility
            }, 1000);
            loadBookingExtras(); // Refresh List
            hasBookingChanged = true; // Mark as changed
        });
    }

    function loadBookingExtras() {
        const list = document.getElementById('currentExtrasList');
        const priceDisplay = document.getElementById('posTotalPrice');
        list.innerHTML = '<div class="loading-spinner">Loading...</div>';

        fetch(`/admin/api/booking-extras?id=${currentBookingId}`)
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    renderExtrasList(data.extras);
                    priceDisplay.textContent = parseFloat(data.total_price).toFixed(2) + ' €';
                }
            });
    }

    function renderExtrasList(extras) {
        const list = document.getElementById('currentExtrasList');
        list.innerHTML = '';

        if (!extras || extras.length === 0) {
            list.innerHTML = '<p class="text-muted" style="text-align:center; padding:20px;">No extras added.</p>';
            return;
        }

        const ul = document.createElement('ul');
        ul.className = 'extras-list';
        
        extras.forEach((ex, index) => {
            const li = document.createElement('li');
            li.className = 'extra-row';
            
            let label = '';
            if (ex.type === 'cafe') {
                label = `<span class="extra-name">${ex.name}</span>`;
            } else if (ex.type === 'extension') {
                label = `<span class="extra-name extension">${ex.name}</span>`;
            }

            const totalItemPrice = (parseFloat(ex.price) * (parseInt(ex.qty)||1)).toFixed(2);
            
            // Allow Edit Qty for Cafe? Or just X. User said: "X to remove... price check". 
            // Also "default 1... + and - ... check to add". This was for ADDING.
            // For LIST: "has X".
            
            li.innerHTML = `
                <div class="extra-info">
                     ${label}
                     <div class="extra-details">${ex.qty}x ${parseFloat(ex.price).toFixed(2)}€ = <strong>${totalItemPrice}€</strong></div>
                </div>
                <button class="btn-remove-extra" onclick="removeExtra(${index})">&times;</button>
            `;
            ul.appendChild(li);
        });
        list.appendChild(ul);
    }

    function removeExtra(index) {
        if(!confirm('Remove this item?')) return;
        callApi({
            action: 'remove_item',
            booking_id: currentBookingId,
            index: index
        }).then(data => {
            if(data.success) {
                renderExtrasList(data.extras);
                document.getElementById('posTotalPrice').textContent = parseFloat(data.new_price).toFixed(2) + ' €';
                hasBookingChanged = true; // Mark as changed
            }
        });
    }

    function adjustExtend(delta) {
        const input = document.getElementById('extendHours');
        const msg = document.getElementById('extendMsg');
        let val = parseInt(input.value) + delta;
        
        // Skip 0
        if (delta > 0 && val === 0) val = 1;
        if (delta < 0 && val === 0) val = -1;

        // Constraint: Minimum 1 hour remaining in total booking duration
        if (val < 0) {
            if ((currentBookingDuration + val) < 1) {
                // Show feedback why it's blocked
                msg.textContent = `Min duration 1h (Current: ${currentBookingDuration}h)`;
                msg.className = 'text-warning';
                // Shake animation or similar?
                input.style.borderColor = 'red';
                setTimeout(() => input.style.borderColor = '', 500);
                return; 
            }
        }
        
        if (val < -3) val = -3;
        if (val > 5) val = 5;
        
        input.value = val;
        updateExtendUI(val);
    }
    
    function updateExtendUI(hours) {
        const checkBtn = document.getElementById('btnCheckAvailability');
        const msg = document.getElementById('extendMsg');
        
        const existingBtn = document.getElementById('btnAddTime');
        if(existingBtn) existingBtn.remove();
        
        msg.textContent = ''; // Clear status

        if (hours > 0) {
            // Adding time
            if (checkBtn) checkBtn.style.display = 'block';
        } else {
            // Reducing time
            if (checkBtn) checkBtn.style.display = 'none';
            
            const btn = document.createElement('button');
            btn.id = 'btnAddTime';
            btn.className = 'btn btn-warning btn-block';
            btn.style.marginTop = '20px';
            btn.textContent = `Reduce ${hours} h.`;
            btn.onclick = () => doExtendTime(hours);
            
            if(checkBtn && checkBtn.parentNode) {
                checkBtn.parentNode.appendChild(btn);
            }
        }
    }

    function checkAvailability() {
        const hours = parseInt(document.getElementById('extendHours').value);
        if (hours <= 0) return; // Should not trigger for negative

        const msg = document.getElementById('extendMsg');
        const checkBtn = document.getElementById('btnCheckAvailability');
        
        // Remove existing "Add Button" if any
        const existingBtn = document.getElementById('btnAddTime');
        if(existingBtn) existingBtn.remove();
        
        msg.textContent = 'Checking availability...'; // TRANS: Checking availability...
        msg.className = 'text-info';

        callApi({
            action: 'check_availability',
            booking_id: currentBookingId,
            hours: hours
        }).then(data => {
            if(data.success && data.available) {
                msg.textContent = 'Time available!'; // TRANS: Time available!
                msg.className = 'text-success';
                
                if(checkBtn) checkBtn.style.display = 'none';
                
                // Show Add Button
                const btn = document.createElement('button');
                btn.id = 'btnAddTime';
                btn.className = 'btn btn-success btn-block';
                btn.style.marginTop = '10px';
                btn.textContent = `Add +${hours} h.`;
                btn.onclick = () => doExtendTime(hours);
                
                msg.parentNode.appendChild(btn);
            } else {
                msg.textContent = data.error || 'Time not available'; // TRANS: Time not available
                msg.className = 'text-danger';
            }
        });
    }

    function doExtendTime(hours) {
        const msg = document.getElementById('extendMsg');
        msg.textContent = 'Adding time...';
        
        callApi({
            action: 'extend_time',
            booking_id: currentBookingId,
            hours: hours
        }).then(data => {
            if(data.success) {
                msg.textContent = 'Success! Time extended.'; // TRANS: Success! Time extended.
                msg.className = 'text-success';
                document.getElementById('btnAddTime').remove(); // Remove button
                loadBookingExtras();
                hasBookingChanged = true; // Mark as changed
            } else {
                msg.textContent = data.error || 'Error'; // TRANS: Error
                msg.className = 'text-danger';
            }
        });
    }

    function callApi(payload) {
        return fetch('/admin/api/update-extras', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify(payload)
        }).then(res => res.json());
    }
</script>

<style>
    /* Close Button */
    .close-modal {
        position: absolute; top: 15px; right: 20px;
        color: #fff; font-size: 28px; font-weight: bold; cursor: pointer;
        transition: color 0.3s; z-index: 10;
        width: 30px; height: 30px; display: flex; align-items: center; justify-content: center;
        border: 1px solid rgba(255,255,255,0.2); border-radius: 4px; background: rgba(0,0,0,0.5);
    }
    .close-modal:hover { color: var(--color-gold); border-color: var(--color-gold); }

    /* POS Modal Styles */
    .modal-overlay {
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0,0,0,0.85); z-index: 1000;
        backdrop-filter: blur(5px);
        display: flex; align-items: center; justify-content: center;
    }
    .modal-content.pos-modal {
        background: #121212; /* Solid dark background */
        width: 90%; max-width: 900px; height: 85vh;
        border-radius: 12px; display: flex; flex-direction: column; overflow: hidden;
        border: 1px solid var(--color-gold); /* Gold border for premium feel */
        box-shadow: 0 10px 30px rgba(0,0,0,0.8);
        position: relative; /* For absolute close btn */
    }
    .pos-modal h2 {
        padding: 20px 25px; margin: 0; 
        background: linear-gradient(to right, #1a1a1a, #000); 
        border-bottom: 1px solid rgba(212, 175, 55, 0.2);
        display: flex; justify-content: space-between; align-items: center;
        color: var(--color-gold); font-family: 'Playfair Display', serif;
        /* Padding right to avoid close btn overlap if title is long, though btn is absolute */
        padding-right: 60px; 
    }
    
    /* ... existing tabs styles ... */

    /* Ensure Input Text Centered */
    .extend-controls input {
        width: 80px; height: 80px; font-size: 2.5em; text-align: center; 
        background: #000; border: 2px solid var(--color-gold); color: var(--color-gold); border-radius: 12px;
        /* display: flex; align-items: center; justify-content: center; <-- CAUSES ISSUE */
        line-height: 80px; /* Match height for vertical centering */
        padding: 0; 
    }
    
    /* TABS STYLES (Restored) */
    .pos-tabs {
        display: flex; border-bottom: 1px solid rgba(255,255,255,0.1); 
        background: #0d0d0d;
        padding: 0 10px;
    }
    .pos-tab-btn {
        flex: 1; padding: 18px; background: none; border: none; color: rgba(255,255,255,0.6);
        cursor: pointer; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;
        border-bottom: 3px solid transparent;
        transition: all 0.3s;
    }
    .pos-tab-btn:hover { color: #fff; background: rgba(255,255,255,0.02); }
    .pos-tab-btn.active { 
        color: var(--color-gold); 
        border-bottom: 3px solid var(--color-gold); 
        background: linear-gradient(to top, rgba(212, 175, 55, 0.1), transparent);
    }
    
    .pos-body { 
        flex: 1; overflow-y: auto; padding: 25px; 
        background: #121212; /* Ensure solid background for body too */
    }
    .pos-tab-pane { display: none; }
    .pos-tab-pane.active { display: block; animation: slideIn 0.3s; }

    
    /* Accordion Styles */
    .cafe-cat-section h4 { 
        padding: 12px 15px; 
        background: linear-gradient(to right, #2a2a2a, transparent); 
        margin: 0 0 5px 0; border-left: 3px solid var(--color-gold);
        cursor: pointer; color: #fff; font-size: 1.1em;
        display: flex; justify-content: space-between; align-items: center;
        transition: background 0.2s;
    }
    .cafe-cat-section h4:hover { background: linear-gradient(to right, #333, transparent); }
    .cafe-cat-section h4::after {
        content: '▼'; font-size: 0.8em; color: var(--color-gold); transition: transform 0.3s;
    }
    .cafe-cat-section.collapsed h4::after { transform: rotate(-90deg); }
    
    .cafe-grid {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 15px; margin-bottom: 20px;
        opacity: 1; max-height: 2000px; overflow: hidden; transition: all 0.4s ease-in-out;
    }
    .cafe-cat-section.collapsed .cafe-grid {
        max-height: 0; margin-bottom: 0; opacity: 0;
    }

    /* ... (Rest of styles - Restored) */
    .cafe-item-card {
        background: #1e1e1e; border: 1px solid rgba(255,255,255,0.1); padding: 15px; border-radius: 8px;
        display: flex; flex-direction: column; gap: 8px; transition: transform 0.2s, border-color 0.2s;
    }
    .cafe-item-card:hover { transform: translateY(-2px); border-color: rgba(212, 175, 55, 0.5); }
    
    .cafe-item-name { font-weight: 600; font-size: 1rem; height: 44px; overflow: hidden; line-height: 1.2; }
    .cafe-item-price { color: var(--color-gold); font-weight: bold; font-size: 1.1em; }
    .cafe-item-actions { display: flex; gap: 8px; align-items: center; margin-top: auto; }
    
    .item-qty { 
        width: 35px; text-align: center; border: 1px solid rgba(255,255,255,0.1); 
        background: #000; color: #fff; border-radius: 4px; padding: 4px 0;
    }
    
    .qty-btn { 
        width: 28px; height: 28px; border-radius: 4px; border: 1px solid rgba(255,255,255,0.2); 
        background: #2a2a2a; color: #fff; cursor: pointer; display: flex; align-items: center; justify-content: center;
        font-size: 1.2em;
    }
    .qty-btn:hover { background: #fff; color: #000; }
    
    .btn-add-item {
        flex: 1; background: var(--color-gold); color: #000; border: none; padding: 6px; 
        border-radius: 4px; cursor: pointer; font-weight: bold; text-transform: uppercase; font-size: 0.8em;
    }
    .btn-add-item:hover { background: #eac134; box-shadow: 0 0 10px rgba(212, 175, 55, 0.4); }
    
    /* Extras List */
    .extras-list { list-style: none; padding: 0; margin: 0; }
    .extra-row { 
        display: flex; justify-content: space-between; align-items: center; padding: 15px; 
        background: #1a1a1a; margin-bottom: 10px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.05);
    }
    .extra-info { display: flex; flex-direction: column; gap: 4px; }
    .extra-name { font-weight: bold; font-size: 1.1em; }
    .extra-name.extension { color: var(--color-gold); }
    .extra-details { font-size: 0.9em; color: rgba(255,255,255,0.6); }
    .btn-remove-extra { 
        background: rgba(255, 99, 71, 0.1); border: 1px solid tomato; color: tomato; 
        width: 32px; height: 32px; border-radius: 50%; cursor: pointer; 
        display: flex; align-items: center; justify-content: center; font-size: 1.2em;
    }
    .btn-remove-extra:hover { background: tomato; color: #fff; }

    .extend-controls {
        display: flex; align-items: center; justify-content: center; gap: 20px; margin: 40px 0;
        background: #1a1a1a; padding: 30px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.05);
    }
    .extend-controls .qty-btn { width: 50px; height: 50px; font-size: 1.5em; border-radius: 50%; }


