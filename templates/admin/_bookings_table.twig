<div style="max-height: 70vh; overflow-y: auto;">
    <table class="data-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Date & Time</th>
                <th>Service</th>
                <th>Customer</th>
                <th>Price</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for booking in bookings %}
            <tr>
                <td>#{{ booking.id }}</td>
                <td>
                    {{ booking.booking_date|date('d.m.Y') }}<br>
                    <small style="color: var(--color-muted);">{{ booking.start_time|slice(0,5) }} - {{ booking.end_time|slice(0,5) }}</small>
                </td>
                <td>{{ booking.formatted_service_name }} (Stôl {{ booking.formatted_table_number }})</td>
                <td>
                    {{ booking.customer_name }}<br>
                    <small style="color: var(--color-muted);">{{ booking.customer_phone }}</small>
                </td>
                <td>
                    {{ booking.price }} €
                    {% if booking.coupon_redeemed %}
                        <br><small style="color: var(--admin-success);">Promo: {{ booking.coupon_redeemed }}</small>
                    {% endif %}
                </td>
                <td>
                    <span class="badge badge-{{ booking.status }}">{{ booking.status|capitalize }}</span>
                </td>
                <td>
                    <form method="POST" action="/admin/bookings/update" style="display: inline-flex; gap: 5px;">
                        <input type="hidden" name="booking_id" value="{{ booking.id }}">
                        
                        {# Status Actions based on current status #}
                        {% if booking.status == 'pending' %}
                            <button type="submit" name="status" value="confirmed" 
                                    class="btn btn-sm btn-success" title="Approve">
                                &#10003;
                            </button>
                            <button type="submit" name="status" value="cancelled" 
                                    class="btn btn-sm btn-danger" title="Reject"
                                    onclick="return confirm('Reject this booking?');">
                                &#10005;
                            </button>
                        {% elseif booking.status == 'confirmed' %}
                            <button type="submit" name="status" value="completed" 
                                    class="btn btn-sm btn-primary" title="Complete (Guest Arrived)">
                                &#10003; Done
                            </button>
                            <button type="submit" name="status" value="cancelled" 
                                    class="btn btn-sm btn-danger" title="Cancel Booking"
                                    onclick="return confirm('Cancel this confirmed booking?');">
                                Cancel
                            </button>
                        {% endif %}
                    </form>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="7" style="text-align: center; padding: 40px; color: rgba(255,255,255,0.3);">
                    NO BOOKINGS FOR {{ group|upper|default('THIS PERIOD') }}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
