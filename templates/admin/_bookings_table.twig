<style>
    @keyframes pulse-yellow {
        0% { box-shadow: 0 0 0 0 rgba(255, 193, 7, 0.7); }
        70% { box-shadow: 0 0 0 6px rgba(255, 193, 7, 0); }
        100% { box-shadow: 0 0 0 0 rgba(255, 193, 7, 0); }
    }
    .badge-playing {
        background-color: #ffc107;
        color: #000;
        animation: pulse-yellow 2s infinite;
        font-weight: bold;
        border: 1px solid #ffc107;
    }
    .badge-finished {
        background-color: #155724; /* Dark Green */
        color: #fff;
        font-weight: bold;
        border: 1px solid #155724;
    }
</style>

<div style="max-height: 70vh; overflow-y: auto;">
    <table class="data-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Date & Time</th>
                <th>Service</th>
                <th>Customer</th>
                <th>Price</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for booking in bookings %}
            <tr>
                <td>#{{ booking.id }}</td>
                <td>
                    {{ booking.booking_date|date('d.m.Y') }}<br>
                    <small style="color: var(--color-muted);">{{ booking.start_time|slice(0,5) }} - {{ booking.end_time|slice(0,5) }}</small>
                </td>
                <td>{{ booking.formatted_service_name }} (Stôl {{ booking.formatted_table_number }})</td>
                <td>
                    {{ booking.customer_name }}<br>
                    <small style="color: var(--color-muted);">{{ booking.customer_phone }}</small>
                </td>
                <td>
                    {{ booking.price }} €
                    {% if booking.coupon_redeemed %}
                        <br><small style="color: var(--admin-success);">Promo: {{ booking.coupon_redeemed }}</small>
                    {% endif %}
                </td>
                <td>
                    {# Custom Status Logic for Today/Confirmed #}
                    {% if group == 'today' and booking.status == 'confirmed' and current_time is defined %}
                        {% set startTs = date(booking.booking_date ~ ' ' ~ booking.start_time).timestamp %}
                        {% set endTs = date(booking.booking_date ~ ' ' ~ booking.end_time).timestamp %}
                        {% set nowTs = current_time.timestamp %}
                        
                        {# Handle Midnight Crossing #}
                        {% if endTs <= startTs %}
                            {% set endTs = endTs + 86400 %}
                        {% endif %}
                        
                        {% if nowTs >= startTs and nowTs <= endTs %}
                            <span class="badge badge-playing">Playing Now</span>
                        {% elseif nowTs > endTs %}
                            <span class="badge badge-finished">Finished</span>
                        {% else %}
                            <span class="badge badge-confirmed">Confirmed</span>
                        {% endif %}
                    {% else %}
                        {# Standard Status #}
                         <span class="badge badge-{{ booking.status }}">{{ booking.status|capitalize }}</span>
                    {% endif %}
                </td>
                <td>
                    <form method="POST" action="/admin/bookings/update" style="display: inline-flex; gap: 5px;">
                        <input type="hidden" name="booking_id" value="{{ booking.id }}">
                        

                        {# Status Actions based on current status #}
                        {% if booking.status == 'pending' %}
                            <button type="submit" name="status" value="confirmed" 
                                    class="btn btn-sm btn-success" title="Approve">
                                &#10003;
                            </button>
                            <button type="submit" name="status" value="cancelled" 
                                    class="btn btn-sm btn-danger" title="Reject"
                                    onclick="return confirm('Reject this booking?');">
                                &#10005;
                            </button>
                        {% elseif booking.status == 'confirmed' %}
                            <!-- Extras / POS Button -->
                            <button type="button" class="btn btn-sm btn-info btn-extras" 
                                    data-id="{{ booking.id }}" 
                                    data-duration="{{ booking.duration_hours|default(1) }}"
                                    title="Cafe & Extras">
                                ☕
                            </button>
                            
                            <button type="submit" name="status" value="completed" 
                                    class="btn btn-sm btn-primary" title="Complete (Guest Arrived)">
                                &#10003; Done
                            </button>
                            <button type="submit" name="status" value="cancelled" 
                                    class="btn btn-sm btn-danger" title="Cancel Booking"
                                    onclick="return confirm('Cancel this confirmed booking?');">
                                Cancel
                            </button>
                        {% endif %}
                    </form>
                </td>
            </tr>
            {# Display Extras Row if any exist (optional, or just inside modal?) #}
            {# User said: "All selected indicated as text under reservation". #}
            {% if booking.extras is defined and booking.extras is not empty %}
            <tr>
                <td colspan="7" style="padding-top: 0; padding-bottom: 10px; border-top: none;">
                    <div style="background: rgba(255,255,255,0.05); padding: 5px 10px; border-radius: 4px; font-size: 0.85em; margin-left: 40px;">
                        <strong>Extras:</strong>
                        {% set extraTotal = 0 %}
                        {% for ex in booking.extras %}
                           {% if ex.type == 'cafe' %}
                               {% set extraTotal = extraTotal + (ex.price * ex.qty) %}
                           {% elseif ex.type == 'generic' %}
                               {% set extraTotal = extraTotal + ex.price %}
                           {% endif %}
                           {# Extensions are excluded from extraTotal so they absorb into Game Price #}
                        {% endfor %}
                        
                        {# Game Price Calculation #}
                        {% set gamePrice = booking.price - extraTotal %}
                        
                        {# Safety check: if gamePrice < 0, formatting might look weird, but shouldn't happen if logic is sound #}
                        Game: {{ gamePrice|number_format(2) }}€
                        {% if booking.extras|length > 0 %},{% endif %}

                        {# List Extras #}
                        {% for ex in booking.extras %}
                           {% if ex.type == 'cafe' %}
                               {{ ex.qty }}x {{ ex.name }} ({{ (ex.price * ex.qty)|number_format(2) }}€){{ not loop.last ? ',' : '' }}
                           {% elseif ex.type == 'generic' %}
                               {{ ex.name }} ({{ ex.price|number_format(2) }}€){{ not loop.last ? ',' : '' }}
                           {% endif %}
                           {# Extensions are hidden as they are part of Game Price #}
                        {% endfor %}
                    </div>
                </td>
            </tr>
            {% endif %}


            {% else %}
            <tr>
                <td colspan="7" style="text-align: center; padding: 40px; color: rgba(255,255,255,0.3);">
                    NO BOOKINGS FOR {{ group|upper|default('THIS PERIOD') }}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
