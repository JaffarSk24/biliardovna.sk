{% if popup_settings.enabled and popup_settings.content is not empty %}
<div id="info-popup" class="info-popup-overlay" style="display: none;">
    <div class="info-popup-content">
        <button id="info-popup-close" class="info-popup-close">&times;</button>
        <div class="info-popup-body">
            {{ popup_settings.content|raw }}
        </div>
    </div>
</div>

<style>
    .info-popup-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7);
        z-index: 9999;
        display: flex;
        justify-content: center;
        align-items: center;
        backdrop-filter: blur(5px);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .info-popup-overlay.visible {
        opacity: 1;
    }

    .info-popup-content {
        background: var(--bg-card, #1e1e1e);
        color: var(--text-color, #fff);
        padding: 40px;
        border-radius: 12px;
        max-width: 600px;
        width: 90%;
        position: relative;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
        border: 1px solid var(--color-gold, #c5a47e);
        transform: scale(0.9);
        transition: transform 0.3s ease;
        max-height: 90vh;
        overflow-y: auto;
    }

    .info-popup-overlay.visible .info-popup-content {
        transform: scale(1);
    }

    .info-popup-close {
        position: absolute;
        top: 10px;
        right: 15px;
        background: none;
        border: none;
        color: var(--text-muted, #aaa);
        font-size: 28px;
        cursor: pointer;
        line-height: 1;
        transition: color 0.2s;
    }

    .info-popup-close:hover {
        color: var(--color-gold, #c5a47e);
    }

    .info-popup-body {
        font-family: inherit;
        line-height: 1.6;
    }

    .info-popup-body h1, .info-popup-body h2, .info-popup-body h3 {
        color: var(--color-gold, #c5a47e);
        margin-bottom: 15px;
    }
    
    .info-popup-body p {
        margin-bottom: 15px;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Check if popup should be shown
        // Using sessionStorage so it shows once per browser session (tab open)
        // Or localStorage for longer/persistent? User said "once on entry".
        // Usually "once on entry" = sessionStorage or localStorage with timestamp.
        // Let's use sessionStorage for "every time they open the browser fresh"
        
        var popup = document.getElementById('info-popup');
        var closeBtn = document.getElementById('info-popup-close');
        
        if (!popup) return;

        var hasSeenPopup = sessionStorage.getItem('hasSeenInfoPopup');

        if (!hasSeenPopup) {
            // Slight delay for smooth entrance
            setTimeout(function() {
                popup.style.display = 'flex';
                // Trigger reflow
                popup.offsetHeight; 
                popup.classList.add('visible');
            }, 500);

            // Mark as seen immediately (or after close? usually immediately to prevent annoyance loop)
            sessionStorage.setItem('hasSeenInfoPopup', 'true');
        }

        function closeInfoPopup() {
            popup.classList.remove('visible');
            setTimeout(function() {
                popup.style.display = 'none';
            }, 300);
        }

        if (closeBtn) {
            closeBtn.addEventListener('click', closeInfoPopup);
        }

        // Close on outside click
        popup.addEventListener('click', function(e) {
            if (e.target === popup) {
                closeInfoPopup();
            }
        });
        
        // Close on Esc
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && popup.classList.contains('visible')) {
                closeInfoPopup();
            }
        });
    });
</script>
{% endif %}
