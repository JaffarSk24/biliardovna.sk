        };
    </script>

    <script src="/public/js/app.js"></script>
    <script src="/public/js/booking.js"></script>
    <script src="/public/js/events.js"></script>
    <script src="/public/js/booking-popup.js"></script>

    {% block scripts %}{% endblock %}
</body>
</html>