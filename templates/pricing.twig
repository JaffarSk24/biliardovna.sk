{% extends "base.twig" %}

{% block head %}
<link rel="stylesheet" href="/public/css/pricing.css?v=2">
{% endblock %}

{% block content %}
<section class="pricing-hero">
  <div class="container">
    <h1>{{ translations.pricing_title|default('Cenník') }}</h1>
    <p class="pricing-subtitle">{{ translations.pricing_subtitle|default('Transparentné ceny pre všetky naše služby') }}</p>
  </div>
</section>

<section class="pricing-tables">
  <div class="container">
    <div class="pricing-tabs">
      <button class="pricing-tab active" data-service="1">
        {{ translations.games_piramida_title|default('Pyramída') }}
      </button>
      <button class="pricing-tab" data-service="2">
        {{ translations.games_pool_title|default('Pool') }}
      </button>
      <button class="pricing-tab" data-service="3">
        {{ translations.games_darts_title|default('Šípky') }}
      </button>
      <button class="pricing-tab" data-service="5">
        {{ translations.games_shuffleboard_title|default('Shuffleboard') }}
      </button>
      <button class="pricing-tab" data-service="4">
        {{ translations.games_foosball_title|default('Stolný futbal') }}
      </button>
    </div>

    <div class="pricing-content">
      <!-- Pyramída -->
      <div class="pricing-table-wrapper active" data-service="1">
        <div class="pricing-table-scroll">
          <table class="pricing-table">
            {% include '_pricing_rows.twig' with {rows: pricing_tables[1]|default([])} %}
          </table>
        </div>
        <div class="pricing-action">
          <button class="btn-primary btn-book-service"
                  data-service-id="1"
                  data-trigger='{"service":1}'>
            {{ translations.btn_book|default('Rezervovať') }}
          </button>
        </div>
      </div>

      <!-- Pool -->
      <div class="pricing-table-wrapper" data-service="2">
        <div class="pricing-table-scroll">
          <table class="pricing-table">
            {% include '_pricing_rows.twig' with {rows: pricing_tables[2]|default([])} %}
          </table>
        </div>
        <div class="pricing-action">
          <button class="btn-primary btn-book-service"
                  data-service-id="2"
                  data-trigger='{"service":2}'>
            {{ translations.btn_book|default('Rezervovať') }}
          </button>
        </div>
      </div>

      <!-- Darts -->
      <div class="pricing-table-wrapper" data-service="3">
        <div class="pricing-table-scroll">
          <table class="pricing-table">
            {% include '_pricing_rows.twig' with {rows: pricing_tables[3]|default([])} %}
          </table>
        </div>
        <div class="pricing-action">
          <button class="btn-primary btn-book-service"
                  data-service-id="3"
                  data-trigger='{"service":3}'>
            {{ translations.btn_book|default('Rezervovať') }}
          </button>
        </div>
      </div>

      <!-- Shuffleboard -->
      <div class="pricing-table-wrapper" data-service="5">
        <div class="pricing-table-scroll">
          <table class="pricing-table">
            {% include '_pricing_rows.twig' with {rows: pricing_tables[5]|default([])} %}
          </table>
        </div>
        <div class="pricing-action">
          <button class="btn-primary btn-book-service"
                  data-service-id="5"
                  data-trigger='{"service":5}'>
            {{ translations.btn_book|default('Rezervovať') }}
          </button>
        </div>
      </div>

      <!-- Table Football -->
      <div class="pricing-table-wrapper" data-service="4">
        <div class="pricing-table-scroll">
          <table class="pricing-table">
            {% include '_pricing_rows.twig' with {rows: pricing_tables[4]|default([])} %}
          </table>
        </div>
        <div class="pricing-action">
          <button class="btn-primary btn-book-service"
                  data-service-id="4"
                  data-trigger='{"service":4}'>
            {{ translations.btn_book|default('Rezervovať') }}
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

{% include 'booking_popup.twig' %}

<script>
document.addEventListener('DOMContentLoaded', function () {
  // Переключение вкладок (без вмешательства в попап)
  const tabs = document.querySelectorAll('.pricing-tab');
  const tables = document.querySelectorAll('.pricing-table-wrapper');

  function activate(serviceId) {
    tabs.forEach(t => t.classList.toggle('active', t.dataset.service === serviceId));
    tables.forEach(w => w.classList.toggle('active', w.dataset.service === serviceId));
  }

  tabs.forEach(tab => {
    tab.addEventListener('click', () => activate(tab.dataset.service));
  });
});
</script>

<script src="/public/js/pricing.js?v=2"></script>
{% endblock %}